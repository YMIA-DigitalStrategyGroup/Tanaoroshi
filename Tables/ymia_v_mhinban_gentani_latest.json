    "SourceTableSchema": "",
    "CreateViewSql": "with `latest_hinban` as (select `h1`.`HINBAN` AS `HINBAN`,`h1`.`HINMEI` AS `HINMEI`,`h1`.`KIKAKU` AS `KIKAKU`,`h1`.`KEISHIKI` AS `KEISHIKI`,`h1`.`MAKER` AS `MAKER` from `mhinban` `h1` where (`h1`.`KAITEI_SEQ_NBR` = (select max(`h2`.`KAITEI_SEQ_NBR`) from `mhinban` `h2` where (`h2`.`HINBAN` = `h1`.`HINBAN`)))), `latest_gentani` as (select `g1`.`HINBAN` AS `HINBAN`,max(`g1`.`TANKA`) AS `TANKA` from `mgentani` `g1` where (`g1`.`AVAILABLE_DATE` = (select max(`g2`.`AVAILABLE_DATE`) from `mgentani` `g2` where (`g2`.`HINBAN` = `g1`.`HINBAN`))) group by `g1`.`HINBAN`) select `h`.`HINBAN` AS `品番`,`h`.`HINMEI` AS `品名`,`h`.`KIKAKU` AS `規格`,`h`.`KEISHIKI` AS `型式`,`h`.`MAKER` AS `メーカー`,coalesce(`g`.`TANKA`,0) AS `原単位金額` from (`latest_hinban` `h` left join `latest_gentani` `g` on((`h`.`HINBAN` = `g`.`HINBAN`)))",
