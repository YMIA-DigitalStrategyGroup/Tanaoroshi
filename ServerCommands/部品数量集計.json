      "SqlStatement": "INSERT INTO ymia_t_tanaoroshi_data\r\nSELECT \r\n    dt.TARGET_YEAR_MONTH,\r\n    mh.TANABAN,\r\n    dt.Z_FLAG,\r\n    '0',\r\n    dt.HINBAN,\r\n    0,\r\n    SUM(dt.TANA_SU)\r\nFROM \r\n    ymia_t_tanaoroshi_datainput dt\r\nLEFT JOIN (\r\n        SELECT \r\n            TANABAN, \r\n            HINBAN\r\n        FROM \r\n            mhinban\r\n        WHERE (HINBAN, KAITEI_SEQ_NBR) IN (\r\n                SELECT \r\n                    HINBAN, \r\n                    MAX(KAITEI_SEQ_NBR)\r\n                FROM \r\n                    mhinban\r\n                GROUP BY \r\n                    HINBAN\r\n            )\r\n    ) mh \r\n    ON dt.HINBAN = mh.HINBAN\r\n    where TARGET_YEAR_MONTH = ?棚卸対象月",
      "ID": "590683339939428cb2ea2fc4e4434834"
    }
